# ==============================================================================
# PROJECT ATLAS — MONOREPO ROOT CONFIGURATION TEMPLATE
# ==============================================================================

# API Configuration
PORT=3000
NODE_ENV=production
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require
JWT_SECRET=super-secret-jwt-key-minimum-64-characters-long
JWT_REFRESH_SECRET=super-secret-refresh-key-minimum-64-characters-long
REDIS_URL=redis://localhost:6379
GEMINI_API_KEY=AIzaSy...your-gemini-key

# Browser origins allowed to call the API, comma separated.
# REQUIRED in production: when unset the API reflects any origin while also
# allowing credentials, which lets any site make authenticated calls on a
# signed-in user's behalf.
CORS_ORIGIN=https://your-web-domain.com

# Number of proxy hops to trust for the real client IP (Railway/most PaaS = 1).
# Without this, req.ip is the load balancer for every request, so all users
# share a single rate-limit bucket.
TRUST_PROXY_HOPS=1

# Database connection pool. The pool is kept warm because each new connection
# costs a full round trip to the database region.
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000

# Credential-endpoint rate limits. Defaults are deliberately strict; raise them
# only for automated test runs, never in production.
AUTH_THROTTLE_TTL_MS=60000
AUTH_LOGIN_LIMIT=5
AUTH_SIGNUP_LIMIT=5
AUTH_REFRESH_LIMIT=10

# Web Frontend Configuration
WEB_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Server-side target for the Next.js /api/proxy route.
# SET THIS EXPLICITLY in every deployment. If it is missing, the proxy tries
# localhost first and then falls back to a hardcoded Railway URL, which can
# silently send one environment's traffic to another environment's API.
BACKEND_URL=http://localhost:3000/api/v1
BACKEND_FALLBACK_URL=
BACKEND_TIMEOUT_MS=30000

# End-to-end test targets (Playwright)
E2E_WEB_URL=http://localhost:3001
E2E_API_URL=http://localhost:3000/api/v1