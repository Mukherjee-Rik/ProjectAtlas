{
  "name": "project-atlas",
  "private": true,
  "version": "0.1.0",
  "main": "apps/api/dist/main.js",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter api --filter web dev",
    "dev:api": "pnpm --filter api start:dev",
    "dev:web": "pnpm --filter web dev",
    "start": "node apps/api/dist/main.js",
    "start:prod": "node apps/api/dist/main.js",
    "start:api": "node apps/api/dist/main.js",
    "build": "pnpm --filter api build",
    "build:all": "pnpm --filter api build && pnpm --filter web build",
    "build:api": "pnpm --filter api build",
    "build:web": "pnpm --filter web build",
    "test": "pnpm --filter api test",
    "test:api": "pnpm --filter api test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:desktop": "playwright test --project=desktop",
    "test:e2e:mobile": "playwright test --project=mobile",
    "test:e2e:report": "playwright show-report",
    "test:security": "node scripts/test-multi-tenant-security.mjs",
    "test:load": "node scripts/test-load-and-resilience.mjs",
    "test:pilot": "node scripts/test-pilot-onboarding.mjs",
    "db:backup": "node --env-file=apps/api/.env scripts/backup-and-restore.mjs",
    "pdf:export": "node scripts/generate-pdf.mjs",
    "lint:api": "pnpm --filter api lint"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node-cron": "^3.0.11",
    "dotenv": "^17.4.2",
    "prisma": "^7.9.1"
  },
  "dependencies": {
    "node-cron": "^4.6.0"
  }
}