# ==============================================================================
# PROJECT ATLAS — API ENVIRONMENT CONFIGURATION
# ==============================================================================

# Core Application Settings
NODE_ENV=production
PORT=3000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3001,https://app.atlas-pos.com

# PostgreSQL Database (Direct & Pooled Connections)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require
DATABASE_DIRECT_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require

# Authentication & JWT Secrets (Rotate regularly in production)
JWT_SECRET=replace-with-a-secure-random-64-character-jwt-secret
JWT_EXPIRATION=1d
JWT_REFRESH_SECRET=replace-with-a-secure-random-64-character-refresh-secret
JWT_REFRESH_EXPIRATION=7d

# Redis / Caching & Async Queue
REDIS_URL=redis://default:[PASSWORD]@[HOST]:6379

# AI Assistant & Reasoning Engine
GEMINI_API_KEY=AIzaSy...your-production-gemini-api-key

# Telemetry & Monitoring
LOG_LEVEL=info
ENABLE_METRICS=true
METRICS_P99_THRESHOLD_MS=1500