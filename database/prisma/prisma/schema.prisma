// ==========================================
// V2.4 ADVANCED FORECASTING FOUNDATION
// ==========================================
model Forecast {
  id           String   @id @default(uuid())
  tenantId     String
  restaurantId String
  branchId     String?
  forecastType String   // 'SALES' | 'ORDERS' | 'MENU_DEMAND'
  granularity  String   // 'HOURLY' | 'DAILY' | 'WEEKLY'
  startDate    DateTime @db.Date
  endDate      DateTime @db.Date
  modelVersion String   @default("baseline-v1")
  status       String   @default("COMPLETED")
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant   Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch       Branch?         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  points       ForecastPoint[]

  @@index([restaurantId, forecastType, startDate])
  @@index([branchId, startDate])
  @@map("forecasts")
}

model ForecastPoint {
  id             String   @id @default(uuid())
  forecastId     String
  timestamp      DateTime
  metric         String   // 'GROSS_SALES', 'TOTAL_ORDERS', 'ITEM_UNITS'
  entityType     String   // 'RESTAURANT', 'BRANCH', 'MENU_ITEM', 'CATEGORY'
  entityId       String?
  predictedValue Decimal  @db.Decimal(12, 2)
  lowerBound     Decimal  @db.Decimal(12, 2)
  upperBound     Decimal  @db.Decimal(12, 2)
  confidence     Decimal  @db.Decimal(5, 2) // e.g. 85.50

  forecast       Forecast @relation(fields: [forecastId], references: [id], onDelete: Cascade)

  @@index([forecastId, timestamp])
  @@index([entityType, entityId])
  @@map("forecast_points")
}

model ForecastRun {
  id               String   @id @default(uuid())
  tenantId         String
  restaurantId     String
  branchId         String?
  modelVersion     String
  recordsProcessed Int      @default(0)
  errorCount       Int      @default(0)
  executionTimeMs  Int      @default(0)
  status           String   // 'SUCCESS' | 'FAILED'
  errorMessage     String?
  startedAt        DateTime @default(now())
  completedAt      DateTime @default(now())

  @@index([restaurantId, startedAt])
  @@map("forecast_runs")
}

model ForecastAccuracy {
  id              String   @id @default(uuid())
  tenantId        String
  restaurantId    String
  branchId        String?
  metric          String
  evalDate        DateTime @db.Date
  predictedValue  Decimal  @db.Decimal(12, 2)
  actualValue     Decimal  @db.Decimal(12, 2)
  absoluteError   Decimal  @db.Decimal(12, 2)
  percentageError Decimal  @db.Decimal(6, 2)
  modelVersion    String
  createdAt       DateTime @default(now())

  @@index([restaurantId, metric, evalDate])
  @@map("forecast_accuracies")
}