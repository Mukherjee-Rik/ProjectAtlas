  triggeredBy  String   // 'MANUAL' | 'SCHEDULED'
  actorUserId  String?
  status       String   // 'PENDING' | 'SUCCESS' | 'FAILED'
  durationMs   Int      @default(0)
  recordsCount Int      @default(0)
  errorMessage String?
  createdAt    DateTime @default(now())

  report       CustomReport    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  schedule     ReportSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@index([restaurantId, createdAt])
  @@index([reportId])
  @@map("report_execution_histories")
