generator client {
  provider     = "prisma-client"
  output       = "../../../apps/api/src/generated/prisma"
  moduleFormat = "cjs"
  // Lets nested reads resolve in one SQL join instead of one query per
  // relation. The database is in another region, so each saved query is a
  // saved network round trip.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String             @id @default(uuid())
  name         String
  email        String             @unique
  phone        String?            @unique
  passwordHash String
  role         UserRole           @default(USER)
  status       UserStatus         @default(ACTIVE)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  memberships  TenantMembership[]
  sessions     Session[]
  aiUsages     AiUsage[]

  @@index([role])
  @@index([status])
  @@map("users")
}

enum UserRole {
  PLATFORM_ADMIN
  OWNER
  ADMIN
  MANAGER
  STAFF
  WAITER
  KITCHEN
  CASHIER
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum TenantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum RestaurantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum BranchStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum DiningAreaStatus {
  ACTIVE
  INACTIVE
}

enum TableStatus {
  ACTIVE
  INACTIVE
}

enum CustomerSessionStatus {
  ACTIVE
  ENDED
  EXPIRED
}

enum MenuStatus {
  ACTIVE
  INACTIVE
}

enum MenuCategoryStatus {
  ACTIVE
  INACTIVE
}

enum MenuItemStatus {
  ACTIVE
  INACTIVE
}

enum DietaryType {
  VEG
  NON_VEG
  EGG
  VEGAN
}

enum FoodType {
  FOOD
  BEVERAGE
  DESSERT
  OTHER
}

enum TaxType {
  PERCENTAGE
  FIXED
}

enum TaxRateStatus {
  ACTIVE
  INACTIVE
}

enum MenuItemVariantStatus {
  ACTIVE
  INACTIVE
}

enum MenuItemAddonStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
}

model Tenant {
  id          String             @id @default(uuid())
  name        String
  slug        String             @unique
  status      TenantStatus       @default(ACTIVE)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  restaurants Restaurant[]
  memberships TenantMembership[]

  @@map("tenants")
}

model Restaurant {
  id        String           @id @default(uuid())
  tenantId  String
  name      String
  slug      String
  status    RestaurantStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branches Branch[]
  menus    Menu[]
  taxRates TaxRate[]
  orders   Order[]
  subscriptions Subscription[]
  deliveryProviders RestaurantDeliveryProvider[]
  aiUsages     AiUsage[]
  automationRules AutomationRule[]
  notifications   Notification[]
  supportTickets  SupportTicket[]
  customers       Customer[]
  dailySalesAggregates DailySalesAggregate[]
  menuItemDailyMetrics MenuItemDailyMetrics[]
  savedReports    SavedReport[]
  customReports   CustomReport[]
  forecasts       Forecast[]

  @@index([tenantId])
  @@unique([tenantId, slug])
  @@map("restaurants")
}

model TenantMembership {
  id        String   @id @default(uuid())
  userId    String
  tenantId  String
  role      UserRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([userId])
  @@index([tenantId])
  @@map("tenant_memberships")
}

model Branch {
  id           String       @id @default(uuid())
  restaurantId String

  name       String
  code       String
  address    String?
  city       String?
  state      String?
  postalCode String?
  phone      String?
  status     BranchStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant  Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  diningAreas DiningArea[]
  orders      Order[]
  dailySalesAggregates DailySalesAggregate[]
  menuItemDailyMetrics MenuItemDailyMetrics[]
  forecasts   Forecast[]

  @@unique([restaurantId, code])
  @@index([restaurantId])
  @@index([status])
  @@map("branches")
}

model DiningArea {
  id       String @id @default(uuid())
  branchId String

  name   String
  code   String
  status DiningAreaStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tables Table[]

  @@unique([branchId, code])
  @@index([branchId])
  @@map("dining_areas")
}

model Table {
  id           String @id @default(uuid())
  diningAreaId String

  publicToken  String @unique @default(dbgenerated("gen_random_uuid()"))
  name         String
  code         String
  capacity     Int
  status       TableStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  diningArea       DiningArea        @relation(fields: [diningAreaId], references: [id], onDelete: Cascade)
  customerSessions CustomerSession[]
  orders           Order[]

  @@unique([diningAreaId, code])
  @@index([diningAreaId])
  @@index([status])
  @@map("tables")
}

model CustomerSession {
  id           String                @id @default(uuid())
  tableId      String
  sessionToken String                @unique
  status       CustomerSessionStatus @default(ACTIVE)

  startedAt DateTime  @default(now())
  expiresAt DateTime?
  endedAt   DateTime?

  table  Table   @relation(fields: [tableId], references: [id], onDelete: Cascade)
  cart   Cart?
  orders Order[]
  payments Payment[]

  @@index([tableId])
  @@index([status])
  @@map("customer_sessions")
}

model Menu {
  id           String     @id @default(uuid())
  restaurantId String

  name   String
  code   String
  status MenuStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categories MenuCategory[]

  @@unique([restaurantId, code])
  @@index([restaurantId])
  @@map("menus")
}

model MenuCategory {
  id     String @id @default(uuid())
  menuId String

  name     String
  code     String
  position Int                @default(0)
  status   MenuCategoryStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  menu  Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  items MenuItem[]

  @@unique([menuId, code])
  @@index([menuId])
  @@index([position])
  @@map("menu_categories")
}

model MenuItem {
  id         String @id @default(uuid())
  categoryId String
  taxRateId  String?

  name                   String
  code                   String
  description            String?
  imageUrl               String?
  price                  Decimal        @db.Decimal(10, 2)
  dietaryType            DietaryType    @default(VEG)
  foodType               FoodType       @default(FOOD)
  preparationTimeMinutes Int?
  position               Int            @default(0)
  status                 MenuItemStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category      MenuCategory           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  taxRate       TaxRate?               @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  variantGroups MenuItemVariantGroup[]
  addonGroups   MenuItemAddonGroup[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  recipe        Recipe?
  dailyMetrics  MenuItemDailyMetrics[]

  @@unique([categoryId, code])
  @@index([categoryId])
  @@index([status])
  @@index([position])
  @@map("menu_items")
}

model TaxRate {
  id           String        @id @default(uuid())
  restaurantId String

  name   String
  type   TaxType
  value  Decimal       @db.Decimal(10, 2)
  status TaxRateStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItems  MenuItem[]

  @@index([restaurantId])
  @@map("tax_rates")
}

model MenuItemVariantGroup {
  id         String @id @default(uuid())
  menuItemId String

  name     String
  required Boolean @default(false)
  position Int     @default(0)

  menuItem MenuItem            @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  variants MenuItemVariant[]

  @@index([menuItemId])
  @@map("menu_item_variant_groups")
}

model MenuItemVariant {
  id      String @id @default(uuid())
  groupId String

  name     String
  price    Decimal               @db.Decimal(10, 2)
  position Int                   @default(0)
  status   MenuItemVariantStatus @default(ACTIVE)

  group MenuItemVariantGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@map("menu_item_variants")
}

model MenuItemAddonGroup {
  id         String @id @default(uuid())
  menuItemId String

  name      String
  required  Boolean @default(false)
  minSelect Int     @default(0)
  maxSelect Int     @default(1)
  position  Int     @default(0)

  menuItem MenuItem          @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  addons   MenuItemAddon[]

  @@index([menuItemId])
  @@map("menu_item_addon_groups")
}

model MenuItemAddon {
  id      String @id @default(uuid())
  groupId String

  name     String
  price    Decimal             @db.Decimal(10, 2)
  position Int                 @default(0)
  status   MenuItemAddonStatus @default(ACTIVE)

  group MenuItemAddonGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@map("menu_item_addons")
}

model Cart {
  id                String @id @default(uuid())
  customerSessionId String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerSession CustomerSession @relation(fields: [customerSessionId], references: [id], onDelete: Cascade)
  items           CartItem[]

  @@index([customerSessionId])
  @@map("carts")
}

model CartItem {
  id         String @id @default(uuid())
  cartId     String
  menuItemId String

  quantity   Int     @default(1)
  unitPrice  Decimal @db.Decimal(10, 2)
  totalPrice Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart     Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  variantSelections CartItemVariant[]
  addonSelections   CartItemAddon[]

  @@index([cartId])
  @@index([menuItemId])
  @@map("cart_items")
}

model CartItemVariant {
  id         String @id @default(uuid())
  cartItemId String
  variantId  String

  name  String
  price Decimal @db.Decimal(10, 2)

  cartItem CartItem @relation(fields: [cartItemId], references: [id], onDelete: Cascade)

  @@index([cartItemId])
  @@map("cart_item_variants")
}

model CartItemAddon {
  id         String @id @default(uuid())
  cartItemId String
  addonId    String

  name  String
  price Decimal @db.Decimal(10, 2)

  cartItem CartItem @relation(fields: [cartItemId], references: [id], onDelete: Cascade)

  @@index([cartItemId])
  @@map("cart_item_addons")
}

model Order {
  id                String      @id @default(uuid())
  restaurantId      String
  branchId          String
  tableId           String?
  customerSessionId String?
  customerId        String?

  orderNumber       String

  status            OrderStatus @default(PENDING)
  source            OrderSource @default(DIRECT)

  subtotal          Decimal     @db.Decimal(10, 2)
  taxAmount         Decimal     @db.Decimal(10, 2)
  discountAmount    Decimal     @db.Decimal(10, 2)
  totalAmount       Decimal     @db.Decimal(10, 2)

  cancelledAt         DateTime?
  cancelledBy         String?
  cancellationReason  String?
  cancellationNote    String?

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  restaurant      Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch          Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  table           Table?           @relation(fields: [tableId], references: [id], onDelete: SetNull)
  customerSession CustomerSession? @relation(fields: [customerSessionId], references: [id], onDelete: SetNull)
  customer        Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)

  items OrderItem[]
  payments Payment[]
  invoice Invoice?
  stockLedgers StockLedger[]
  externalOrder ExternalOrder?
  cancellationRequests CancellationRequest[]
  refunds Refund[]

  @@unique([restaurantId, orderNumber])
  @@index([restaurantId])
  @@index([branchId])
  @@index([tableId])
  @@index([customerSessionId])
  @@index([customerId])
  @@index([status])
  @@index([restaurantId, status, createdAt])
  @@index([restaurantId, createdAt])
  @@index([branchId, status, createdAt])
  @@map("orders")
}

model OrderItem {
  id         String  @id @default(uuid())
  orderId    String
  menuItemId String

  name       String
  quantity   Int

  unitPrice  Decimal @db.Decimal(10, 2)
  totalPrice Decimal @db.Decimal(10, 2)
  taxAmount  Decimal @db.Decimal(10, 2)

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  variants OrderItemVariant[]
  addons   OrderItemAddon[]

  @@index([orderId])
  @@index([menuItemId])
  @@index([orderId, menuItemId])
  @@map("order_items")
}

model OrderItemVariant {
  id          String  @id @default(uuid())
  orderItemId String
  variantId   String?

  name  String
  price Decimal @db.Decimal(10, 2)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@map("order_item_variants")
}

model OrderItemAddon {
  id          String  @id @default(uuid())
  orderItemId String
  addonId     String?

  name  String
  price Decimal @db.Decimal(10, 2)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@map("order_item_addons")
}

enum CancellationRequestStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum RefundStatus {
  PENDING
  SUCCESS
  FAILED
}

model CancellationRequest {
  id              String                    @id @default(uuid())
  restaurantId    String
  orderId         String
  requestedBy     String
  requestedByName String?
  reason          String
  note            String?
  status          CancellationRequestStatus @default(PENDING_REVIEW)
  reviewedBy      String?
  reviewedByName  String?
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([orderId])
  @@index([status])
  @@map("cancellation_requests")
}

model Refund {
  id               String       @id @default(uuid())
  restaurantId     String
  orderId          String
  paymentId        String
  amount           Decimal      @db.Decimal(10, 2)
  reason           String
  note             String?
  status           RefundStatus @default(PENDING)
  requestedBy      String?
  approvedBy       String?
  processedAt      DateTime?
  providerRefundId String?
  failureReason    String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([orderId])
  @@index([paymentId])
  @@index([status])
  @@map("refunds")
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
  REFUND_FAILED
}

enum PaymentMethod {
  CASH
  CARD
  UPI_INTENT
  RAZORPAY
  STRIPE
}

model Payment {
  id                   String        @id @default(uuid())
  tenantId             String
  restaurantId         String
  orderId              String?
  customerSessionId    String?
  invoiceId            String?
  amount               Decimal       @db.Decimal(10, 2)
  method               PaymentMethod
  status               PaymentStatus @default(PENDING)
  transactionReference String?       @unique
  failureReason        String?
  paidAt               DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  order           Order?           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerSession CustomerSession? @relation(fields: [customerSessionId], references: [id], onDelete: Cascade)
  invoice         Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  refunds         Refund[]

  @@index([tenantId])
  @@index([restaurantId])
  @@index([orderId])
  @@index([customerSessionId])
  @@index([invoiceId])
  @@index([status])
  @@index([restaurantId, status, createdAt])
  @@index([orderId, status])
  @@map("payments")
}

model Invoice {
  id             String   @id @default(uuid())
  tenantId       String
  branchId       String
  orderId        String   @unique
  invoiceNumber  String   @unique
  subtotal       Decimal  @db.Decimal(10, 2)
  cgstAmount     Decimal  @default(0.00) @db.Decimal(10, 2)
  sgstAmount     Decimal  @default(0.00) @db.Decimal(10, 2)
  discountAmount Decimal  @default(0.00) @db.Decimal(10, 2)
  finalTotal     Decimal  @db.Decimal(10, 2)
  isSettled      Boolean  @default(false)
  issuedAt       DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([tenantId])
  @@index([branchId])
  @@index([orderId])
  @@map("invoices")
}

enum UnitOfMeasure {
  KG
  GRAM
  LITER
  ML
  PIECE
  BOX
}

enum RecipeType {
  COOKED_TO_ORDER
  BATCH_PREPARED
}

enum StockTransactionType {
  RECIPE_DEDUCTION
  BATCH_PRODUCTION
  BATCH_WASTAGE
  MANUAL_PURCHASE
  WASTE_SPOILAGE
  AUDIT_ADJUSTMENT
}

model Supplier {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  contactName String?
  email       String?
  phone       String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ingredients  Ingredient[]
  stockLedgers StockLedger[]

  @@index([tenantId])
  @@map("suppliers")
}

model InventoryLocation {
  id        String   @id @default(uuid())
  tenantId  String
  branchId  String
  name      String
  code      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ingredients  Ingredient[]
  stockLedgers StockLedger[]

  @@unique([branchId, code])
  @@index([tenantId])
  @@map("inventory_locations")
}

model Ingredient {
  id                  String        @id @default(uuid())
  tenantId            String
  restaurantId        String
  locationId          String?
  supplierId          String?
  name                String
  unitOfMeasure       UnitOfMeasure
  minimumReorderLevel Decimal       @db.Decimal(10, 3)
  costPerUnit         Decimal       @db.Decimal(10, 2)
  currentStock        Decimal       @default(0.00) @db.Decimal(10, 3)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  location            InventoryLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  supplier            Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  recipeIngredients   RecipeIngredient[]
  stockLedgers        StockLedger[]

  @@index([tenantId])
  @@index([restaurantId])
  @@index([locationId])
  @@index([supplierId])
  @@map("ingredients")
}

model Recipe {
  id                 String             @id @default(uuid())
  menuItemId         String             @unique
  recipeType         RecipeType         @default(COOKED_TO_ORDER)
  batchYieldPortions Decimal            @default(1.00) @db.Decimal(10, 2)
  preparedStock      Decimal            @default(0.00) @db.Decimal(10, 2)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  menuItem          MenuItem           @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  recipeIngredients RecipeIngredient[]
  batchProductions  BatchProduction[]

  @@map("recipes")
}

model BatchProduction {
  id                String    @id @default(uuid())
  tenantId          String
  branchId          String
  recipeId          String
  portionsProduced  Decimal   @db.Decimal(10, 2)
  portionsRemaining Decimal   @db.Decimal(10, 2)
  notes             String?
  producedAt        DateTime  @default(now())
  expiresAt         DateTime?
  status            String    @default("ACTIVE")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  recipe            Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([branchId])
  @@index([recipeId])
  @@map("batch_productions")
}

model RecipeIngredient {
  id               String   @id @default(uuid())
  recipeId         String
  ingredientId     String
  quantityRequired Decimal  @db.Decimal(10, 3)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([recipeId])
  @@index([ingredientId])
  @@map("recipe_ingredients")
}

model StockLedger {
  id               String               @id @default(uuid())
  tenantId         String
  branchId         String
  ingredientId     String
  locationId       String?
  supplierId       String?
  transactionType  StockTransactionType
  quantityDelta    Decimal              @db.Decimal(10, 3)
  balanceAfter     Decimal              @db.Decimal(10, 3)
  referenceOrderId String?
  createdAt        DateTime             @default(now())

  ingredient Ingredient         @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  location   InventoryLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  supplier   Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  order      Order?             @relation(fields: [referenceOrderId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([branchId])
  @@index([ingredientId])
  @@index([locationId])
  @@index([supplierId])
  @@index([referenceOrderId])
  @@map("stock_ledgers")
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum PlanStatus {
  ACTIVE
  INACTIVE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
  SUSPENDED
}

model Plan {
  id           String             @id @default(uuid())
  name         String             @unique
  price        Decimal            @db.Decimal(10, 2)
  currency     String             @default("INR")
  billingCycle BillingCycle       @default(MONTHLY)
  trialDays    Int                @default(14)
  description  String?
  features     Json               // List of feature strings: ["qr_menu", "table_management", etc.]
  limits       Json               // JSON mapping resource limits: {"maxTables": 20, "maxStaff": 5}
  status       PlanStatus         @default(ACTIVE)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                 String             @id @default(uuid())
  restaurantId       String
  planId             String
  status             SubscriptionStatus @default(TRIALING)
  billingCycle       BillingCycle       @default(MONTHLY)
  trialStart         DateTime?
  trialEnd           DateTime?
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelledAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  restaurant         Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
